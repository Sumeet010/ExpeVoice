# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID from Google Cloud Console.
# Used by Google Identity Services (GSI) for one-tap and popup Google Sign-In.
# FORMAT NOTE: Must be a Web Client ID ending in ".apps.googleusercontent.com"
# (e.g. 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com).
# DO NOT put your GCP project name/ID here (e.g. "voice-expence-tracker" is invalid and causes Google 401 error).
VITE_GOOGLE_CLIENT_ID=

# MONGODB_URI: Connection string for MongoDB (Atlas or self-hosted).
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/voice_expense_tracker
# If omitted or offline, the app utilizes the local MongoDB-compatible storage layer.
MONGODB_URI=

# MONGODB_DB_NAME: Optional MongoDB database name (defaults to "voice_expense_tracker").
MONGODB_DB_NAME=voice_expense_tracker

